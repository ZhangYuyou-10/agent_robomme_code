 RoboMME environment runing wrapper: build envs, get observations, and step with a uniform API.
 """
 from __future__ import annotations
+import os
 from typing import Any
 import numpy as np
+import gymnasium as gym
 
 from robomme.robomme_env import *  # noqa: F401, F403 - env registration
 from robomme.env_record_wrapper import BenchmarkEnvBuilder
@@ -12,6 +14,30 @@ from utils import TASK_NAME_LIST
 
 np.set_printoptions(precision=4, suppress=True)
 
+# Opt-in override for containers where the NVIDIA Vulkan ICD can't create a graphics
+# instance (e.g. NVIDIA_DRIVER_CAPABILITIES missing "graphics"), routing sapien
+# rendering to a software (llvmpipe) device instead. Inert unless ROBOMME_RENDER_BACKEND
+# is set, so normal GPU-rendering setups are unaffected.
+_render_backend_override = os.environ.get("ROBOMME_RENDER_BACKEND")
+if _render_backend_override:
+    if _render_backend_override.startswith("pci:"):
+        # mani_skill's own backend-string parser does `backend.split(":")` and unpacks
+        # exactly 2 parts, which breaks on a multi-colon PCI address. Patch just that
+        # helper so this otherwise-supported special case survives unpacking.
+        import mani_skill.envs.utils.system.backend as _ms_backend
+
+        _orig_parse_backend_device_id = _ms_backend.parse_backend_device_id
+
+        def _patched_parse_backend_device_id(backend: str):
+            if backend.startswith("pci:"):
+                return backend, None
+            return _orig_parse_backend_device_id(backend)
+
+        _ms_backend.parse_backend_device_id = _patched_parse_backend_device_id
+
+    for _env_id in TASK_NAME_LIST:
+        gym.spec(_env_id).kwargs["render_backend"] = _render_backend_override
+
 
